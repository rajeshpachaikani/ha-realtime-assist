# Environment Variables for HA Realtime Voice Assistant
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=sk-...

# Home Assistant Configuration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=eyJ0eXAiOiJKV1...
HA_LANG=en

# OpenWakeWord Configuration (for wake word detection)
# Path to your OpenWakeWord .onnx model file (required)
OWW_MODEL_PATH=config/models/alexa_v0.1.onnx

# Detection threshold (0.0-1.0, default: 0.5)
# Lower values = more sensitive but more false positives
# Higher values = less sensitive but fewer false positives
OWW_DETECTION_THRESHOLD=0.5

# Voice Activity Detection threshold (0.0-1.0, default: 0.6)
OWW_VAD_THRESHOLD=0.6

# Pre-activation buffer in seconds (default: 1.5)
# How long to buffer audio before wake word detection
OWW_PRE_ACTIVATION_BUFFER=1.5

# Optional: Override default voice
OPENAI_VOICE=nova

# Optional: Override default model
OPENAI_MODEL=gpt-4o-realtime-preview

# Optional: Custom log level
LOG_LEVEL=INFO

# Optional: Custom configuration file path
CONFIG_FILE=config/config.yaml
PERSONA_FILE=config/persona.ini

# Web UI Authentication (set by installer, uses bcrypt)
# The installer will automatically generate this when you enable web UI security
WEB_UI_PASSWORD_HASH=