# Environment Variables for HA Realtime Voice Assistant
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=sk-...

# Home Assistant Configuration
HA_URL=http://homeassistant.local:8123
HA_TOKEN=eyJ0eXAiOiJKV1...
HA_LANG=en

# OpenWakeWord Configuration (for wake word detection)
# Models: jarvis, alexa, hey_mycroft, computer, hey_picovoice
OPENWAKEWORD_MODEL=jarvis
OPENWAKEWORD_INFERENCE_FRAMEWORK=onnx
OPENWAKEWORD_CUSTOM_MODEL_PATH=

# Optional: Override default voice
OPENAI_VOICE=nova

# Optional: Override default model
OPENAI_MODEL=gpt-4o-realtime-preview

# Optional: Custom log level
LOG_LEVEL=INFO

# Optional: Custom configuration file path
CONFIG_FILE=config/config.yaml
PERSONA_FILE=config/persona.ini

# Web UI Authentication (set by installer, uses bcrypt)
# The installer will automatically generate this when you enable web UI security
WEB_UI_PASSWORD_HASH=